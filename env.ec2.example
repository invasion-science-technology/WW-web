# Copy on EC2:  cp env.ec2.example .env.ec2  && nano .env.ec2
# Then:         bash scripts/ec2/build-and-deploy.sh
#
# Values are baked into the static JS at build time (required for EC2 / static export).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Local dev only — do NOT set on EC2/production (exposes shared demo credentials in JS)
# NEXT_PUBLIC_PROTO_DEMO_MODE=1
# NEXT_PUBLIC_PROTO_EMAIL=demo@weedwatch.local
# NEXT_PUBLIC_PROTO_PASSWORD=change-me
